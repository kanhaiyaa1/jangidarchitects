# Jangid Architects - settings for Hostinger (Apache / LiteSpeed)
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Always use https
RewriteCond %{HTTPS} off
RewriteRule ^ https://jangidarchitects.com%{REQUEST_URI} [L,R=301]
# Always use the non-www address
RewriteCond %{HTTP_HOST} ^www\.jangidarchitects\.com$ [NC]
RewriteRule ^ https://jangidarchitects.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Make sure modern image types are served with the right type
<IfModule mod_mime.c>
AddType image/webp .webp
</IfModule>

# Smaller downloads
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/html "access plus 1 hour"
</IfModule>
